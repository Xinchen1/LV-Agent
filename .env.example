# Copy this file to .env and fill in your keys.
# .env is gitignored and loaded automatically by python-dotenv if present.

# DeepSeek API key (used when backend=deepseek)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI-compatible endpoint key (used when backend=openai)
OPENAI_API_KEY=your_openai_key_here

# Anthropic API key (used when backend=anthropic)
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenRouter API key (used when backend=openrouter)
OPENROUTER_API_KEY=your_openrouter_key_here

# Telegram bot token (optional)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# SerpAPI key for web search (optional)
SERPAPI_KEY=your_serpapi_key_here
